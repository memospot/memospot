{
  "$schema": "https://plugins.dprint.dev/dprint/dprint-plugin-json/latest/schema.json",
  "excludes": [
    "**/node_modules/*",
    "**/*.lock",
    "**/.dprint/*",
    "**/.git/*",
    "**/target/*",
    "**/build/*",
    "**/lib/paraglide/**",
    "**/gen/schemas/*.json",
    "**/gen/**",
    "recipe.json"
  ],
  "includes": [
    "**/*.{css,html}",
    "**/*.{json,jsonc}",
    "**/*.{md}",
    "**/*.{rs}",
    "**/*.{toml}",
    "**/*.{js,svelte,ts}",
    "**/*.{yml,yaml}"
  ],
  "lineWidth": 96,
  "indentWidth": 4,
  "plugins": [
    // DO NOT USE PRETTIER WASM. It bypasses the include rules and will mess things up.
    //
    // https://github.com/dprint/dprint-plugin-biome/releases
    "npm:@dprint/biome@0.13.13@f67adf82fa88d26d6e1c9225ab96850ee3e81ea1ab5e44224e457128faedfb8e",
    // https://github.com/dprint/dprint-plugin-exec/releases
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
    // https://github.com/g-plane/malva/releases
    "npm:dprint-plugin-malva@0.16.0@c7071f3db5faabdcd0faffc08823a678de939763321b54a05ce108d082f54989",
    // https://github.com/dprint/dprint-plugin-markdown/releases
    "npm:@dprint/markdown@0.26.0@f22d576befb4511ba5d19ddd41414cb00a007db37e70cf0b27ece82b511f6caf",
    // https://github.com/g-plane/markup_fmt/releases
    "npm:dprint-plugin-markup@0.27.5@7005946a1e1b468430fa688babfb7765af1ed638e598290b795bdf6268f0acac",
    // https://github.com/g-plane/pretty_yaml/releases
    "npm:dprint-plugin-yaml@0.6.0@aee3873f443c9f749521ea171cd38ed381491123aa4530684dd0d6e3deb6727b",
    // https://github.com/dprint/dprint-plugin-toml/releases
    "npm:@dprint/toml@0.9.0@2cac97483311ab7e36373e02592b9757f9619f6aa2f7e232bb0a6bd143a75caa"
  ],
  "exec": {
    "commands": [
      {
        "command": "just --dump --justfile {{file_path}}",
        "stdin": false,
        "fileNames": "justfile",
        "exts": ["justfile"]
      },
      {
        "command": "rustfmt --files-with-diff --config-path .rustfmt.toml",
        "exts": ["rs"]
      }
    ]
  },
  "biome": {
    "associations": ["**/*.{js,json,jsonc,ts}"],
    "indentStyle": "space",
    "indentSize": 4,
    "lineEnding": "lf",
    "lineWidth": 96,
    "trailingComma": "none",
    "json.indentSize": 2,
    "json.indentStyle": "space",
    "json.lineWidth": 96
  },
  "malva": {
    // https://dprint.dev/plugins/malva/config/
    "associations": ["**/*.css"],
    "indentWidth": 4,
    "printWidth": 96
  },
  "markdown": {
    "associations": ["**/*.md"],
    "lineWidth": 96
  },
  "markup": {
    "associations": ["**/*.{html,svelte}"],
    "indentWidth": 2,
    "printWidth": 96,
    "svelte.scriptIndent": false,
    "scriptFormatter": "biome"
  },
  "yaml": {
    // https://dprint.dev/plugins/pretty_yaml/config/
    "associations": ["**/*.yml"],
    "indentWidth": 2,
    "printWidth": 96
  },
  "toml": {
    "associations": ["**/*.toml"],
    "lineWidth": 96,
    "useTabs": false,
    "indentWidth": 4,
    "newLineKind": "lf",
    "comment.forceLeadingSpace": false,
    "cargo.applyConventions": true
  }
}
