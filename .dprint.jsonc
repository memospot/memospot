{
  "$schema": "https://plugins.dprint.dev/dprint/dprint-plugin-json/latest/schema.json",
  "excludes": [
    "**/node_modules/*",
    "**/*.lock",
    "**/.dprint/*",
    "**/.git/*",
    "**/target/*",
    "**/build/*",
    "**/lib/paraglide/**",
    "**/gen/schemas/*.json",
    "**/gen/**",
    "recipe.json"
  ],
  "includes": [
    "**/*.{css,html}",
    "**/*.{json,jsonc}",
    "**/*.{md}",
    "**/*.{rs}",
    "**/*.{toml}",
    "**/*.{js,svelte,ts}",
    "**/*.{yml,yaml}"
  ],
  "lineWidth": 96,
  "indentWidth": 4,
  "plugins": [
    // DO NOT USE PRETTIER WASM. It bypasses the include rules and will mess things up.
    //
    // https://github.com/dprint/dprint-plugin-biome/releases
    "npm:@dprint/biome@0.15.7@de09c91f3feddb8a7997c6a0f2e4878ba04168e5b7ffefb53e4975f79a52f653",
    // https://github.com/dprint/dprint-plugin-exec/releases
    "npm:@dprint/exec@0.9.0/plugin.json@d4f708dc00798b51013ca4e7c26a86656bfb31e7255cdcde28a487f86813e34d",
    // https://github.com/g-plane/malva/releases
    "npm:dprint-plugin-malva@0.16.1@fec6fc1cd5f3f26141fa81670a7f5fa1448c68e372fd1b48890fe3087e75f63d",
    // https://github.com/dprint/dprint-plugin-markdown/releases
    "npm:@dprint/markdown@0.29.0@d67ef8fb344b3e50ccc12c246f577303cad49eb0f7a7210731d59684504d72db",
    // https://github.com/g-plane/markup_fmt/releases
    "npm:dprint-plugin-markup@0.28.0@e011a6bdf3e84ca8870748478499f971d819022f62b48c6806aecdb3434a796c",
    // https://github.com/g-plane/pretty_yaml/releases
    "npm:dprint-plugin-yaml@0.6.0@aee3873f443c9f749521ea171cd38ed381491123aa4530684dd0d6e3deb6727b",
    // https://github.com/dprint/dprint-plugin-toml/releases
    "npm:@dprint/toml@0.10.0@b263aee1b268a05bfa84a0ddad2a4a7df403431fbe2df61a42deef1305645f1a"
  ],
  "exec": {
    "commands": [
      {
        "command": "just --dump --justfile {{file_path}}",
        "stdin": false,
        "fileNames": "justfile",
        "exts": ["justfile"]
      },
      {
        "command": "rustfmt --files-with-diff --config-path .rustfmt.toml",
        "exts": ["rs"]
      }
    ]
  },
  "biome": {
    "associations": ["**/*.{js,json,jsonc,ts}"],
    "indentStyle": "space",
    "indentSize": 4,
    "lineEnding": "lf",
    "lineWidth": 96,
    "trailingComma": "none",
    "json.indentSize": 2,
    "json.indentStyle": "space",
    "json.lineWidth": 96
  },
  "malva": {
    // https://dprint.dev/plugins/malva/config/
    "associations": ["**/*.css"],
    "indentWidth": 4,
    "printWidth": 96
  },
  "markdown": {
    "associations": ["**/*.md"],
    "lineWidth": 96
  },
  "markup": {
    "associations": ["**/*.{html,svelte}"],
    "indentWidth": 2,
    "printWidth": 96,
    "svelte.scriptIndent": false,
    "scriptFormatter": "biome"
  },
  "yaml": {
    // https://dprint.dev/plugins/pretty_yaml/config/
    "associations": ["**/*.yml"],
    "indentWidth": 2,
    "printWidth": 96
  },
  "toml": {
    "associations": ["**/*.toml"],
    "lineWidth": 96,
    "useTabs": false,
    "indentWidth": 4,
    "newLineKind": "lf",
    "comment.forceLeadingSpace": false,
    "cargo.applyConventions": true
  }
}
