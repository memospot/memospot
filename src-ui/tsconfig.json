{
  "extends": "$app/tsconfig",
  "include": ["src", "tests", "vite.config.ts"],
  "exclude": ["src/service-worker"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler",
    // $app/tsconfig restricts `types` to "$app/types"; re-add node/bun types.
    "types": ["bun", "node", "$app/types"],
    // Subpath imports (#lib) declared in package.json. TypeScript does not
    // resolve them on its own here, so map them explicitly.
    "paths": {
      "#lib/*": ["./src/lib/*"]
    }
  }
  // `#lib` subpath imports are declared in package.json (`imports` field).
  //
  // If you want to overwrite includes/excludes, make sure to copy over the relevant includes/excludes
  // from the referenced tsconfig.json - TypeScript does not merge them in
}
